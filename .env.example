# Скопируйте этот файл в .env и заполните перед запуском.
# В отличие от старой SQLite-версии, теперь без .env сервер не стартует —
# нужен реальный DATABASE_URL (локальный Postgres или бесплатный проект Supabase).

PORT=4000

# ОБЯЗАТЕЛЬНО смените на длинную случайную строку перед деплоем.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# ОБЯЗАТЕЛЬНО. Строка подключения к Postgres.
# Из Supabase: Project Settings -> Database -> Connection string -> Transaction pooler
# (порт 6543 — экономит соединения, рекомендуется для обычного веб-бэкенда).
# Пример: postgresql://postgres.xxxxxxxx:ВАШ_ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vmeste

# Необязательно: PGSSL=false — полностью отключить TLS (только для локального
# Postgres без TLS). PGSSL_STRICT=true — включить строгую проверку сертификата
# (обычно не нужно для управляемых провайдеров вроде Supabase).
# PGSSL=false
# PGSSL_STRICT=true

# Необязательно: домен фронтенда (или несколько через запятую).
# Пока не задано — CORS открыт для всех источников.
# CORS_ORIGIN=https://vmeste-app.example.com
